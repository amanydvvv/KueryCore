# KueryCore AI Backend — Local Development Configuration Template
#
# ⚠️  CRITICAL MIGRATION SAFETY RULES — READ BEFORE EDITING DATABASE_URL:
#
#   1. NEVER point DATABASE_URL or DATABASE_URL_SYNC at the production
#      Supabase database during local development.
#      Running "alembic upgrade head" locally against production will apply
#      migrations that may not yet be committed to git — causing a
#      "Can't locate revision" crash-loop on Render. (This happened Oct 2026.)
#
#   2. Use docker-compose for a local Postgres:
#        docker-compose up db
#      Then run migrations against localhost:5435 only.
#
#   3. ALWAYS commit migration files BEFORE applying them to production:
#        git add backend/alembic/versions/
#        git commit -m "..."
#        git push
#      Then let Render's Pre-Deploy Command run "alembic upgrade head".
#
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment: "development" auto-generates a JWT secret.
# Any other value (default "production") requires JWT_SECRET_KEY to be set.
ENVIRONMENT=development

# ── Local PostgreSQL (docker-compose) ────────────────────────────────────────
# Async connection — used by FastAPI / asyncpg
DATABASE_URL=postgresql+asyncpg://kuerycore:kuerycore_dev@localhost:5435/kuerycore

# Sync connection — used by Alembic migrations (psycopg2 driver)
DATABASE_URL_SYNC=postgresql://kuerycore:kuerycore_dev@localhost:5435/kuerycore

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Google Gemini API Key — embeddings + vector search (https://aistudio.google.com/)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Groq Cloud API Key — LLM chat generation + vision OCR (https://console.groq.com/)
GROQ_API_KEY=your_actual_groq_api_key_here

# Primary generative model (Groq model id). Change here, not in code.
GENERATIVE_MODEL=openai/gpt-oss-20b

# ── Security ──────────────────────────────────────────────────────────────────
# In development ENVIRONMENT, this is auto-generated. Set explicitly in prod.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_random_jwt_secret_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Note: Starlette does NOT support wildcard globs (e.g. "https://*.vercel.app").
# Use exact origins here. Vercel preview URLs are covered by allow_origin_regex
# in backend/app/main.py.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ── Email (optional — password reset) ────────────────────────────────────────
# BREVO_API_KEY=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# RESEND_API_KEY=
FRONTEND_URL=http://localhost:5173
