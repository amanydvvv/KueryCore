# Python
__pycache__/
*.py[cod]
*$py.class
venv/
backend/venv/
# Environment Variables (Ignore all .env files across any directory; whitelist example files)
**/.env
**/.env.*
.env
.env.*
.env.local
.env.*.local
.env.production
.env.development
!.env.example
!**/.env.example

# Node / React
node_modules/
dist/
.env.local
.vercel/
*.key
*.pem

# Database & Uploads
uploads/
*.db
*.sqlite

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
.pytest_cache/

# QA / audit artifacts
frontend/*.cjs
frontend/*.cjs.py
frontend/record_har.js
frontend/*.png
frontend/qa_artifacts/
frontend/qa_fixture_applicant_2026.pdf
security-audit/
claude-skills/
.serena/
.agents/
.agent/

# Test fixtures: only tracked inside backend/tests/fixtures/
*.pdf
*.txt
!backend/tests/fixtures/
!backend/tests/fixtures/**
!backend/requirements.txt

# Eval run artifacts: timestamped reports and snapshot runs are ignored; results/baseline.json
# is tracked on purpose (the comparison anchor for --diff).
backend/results/*.json
backend/results/eval_*.json
backend/results/baseline_*.json
!backend/results/baseline.json

# Personal & Internal Study/Project Docs
_internal_notes/
.notes/
docs/STUDY_GUIDE.md
docs/PROJECT_LOG.md
docs/ENGINEERING_CHECKLIST.md
docs/PROJECT_CHECKLIST.md
docs/HANDOVER_*.md
docs/PLAN_*.md

# Scratch & Debug Artifacts
*.log
scratchpad/
temp/
scratch/
*.tmp


# Coverage binary
.coverage
backend/.coverage
